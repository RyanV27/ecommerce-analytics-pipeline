GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=datapulse-raw-your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/config/gcp-key.json

# Airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Cloud training (Phase 4.5) — remote MLflow + Cloud Run Job / Vertex AI training.
# Leave unset for local dev; ml/mlflow_utils.py falls back to a local sqlite file.
# MLFLOW_TRACKING_URI is the `mlflow_url` Terraform output (infra/terraform/outputs.tf).
# The remote server's backend store is Cloud SQL Postgres, fully managed by Terraform
# (instance, DB, user, password in Secret Manager) — no separate client-side var needed.
MLFLOW_TRACKING_URI=https://datapulse-mlflow-your-gcp-project-id.a.run.app
# ML_TRAINING_SA is the `ml_training_service_account_email` Terraform output; used by
# infra/submit_vertex_jobs.ps1 and the retrain_models DAG to render the Vertex job specs.
ML_TRAINING_SA=ml-training@your-gcp-project-id.iam.gserviceaccount.com
