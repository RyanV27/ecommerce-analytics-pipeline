GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=datapulse-raw-your-gcp-project-id

# Cloud training (Phase 4.6) — GKE Autopilot Airflow (Helm, KubernetesExecutor,
# Workload Identity), KubernetesPodOperator for segmentation/forecasting, and
# Vertex AI (kept as a deliberate side-by-side pattern) for repeat-purchase.
# Leave unset for local dev; ml/mlflow_utils.py falls back to a local sqlite file.
# MLFLOW_TRACKING_URI is the `mlflow_url` Terraform output (infra/terraform/outputs.tf).
# The remote server's backend store is Cloud SQL Postgres, fully managed by Terraform
# (instance, DB, user, password in Secret Manager) — no separate client-side var needed.
MLFLOW_TRACKING_URI=https://datapulse-mlflow-your-gcp-project-id.a.run.app
# ML_TRAINING_SA is the `ml_training_service_account_email` Terraform output — the
# identity behind the `ml-training` KSA (KubernetesPodOperator pods, via Workload
# Identity) and the retained infra/submit_vertex_repeat_job.ps1 manual submission path.
ML_TRAINING_SA=ml-training@your-gcp-project-id.iam.gserviceaccount.com
# MLFLOW_ARTIFACTS_BUCKET is the `mlflow_artifacts_bucket` Terraform output; also used
# as the destination for Airflow's remote task logs (gs://<bucket>/airflow-logs).
MLFLOW_ARTIFACTS_BUCKET=datapulse-mlflow-your-gcp-project-id
